flowchart LR
    User[User]
    subgraph Machine[Local machine]
        Browser[Browser UI]
        CLI[Command line]
        subgraph App[Reel Factory - Python application]
            Web[Flask web routes]
            Work[Shared generation and build pipeline]
            Media[Photo analysis and collection preparation]
            Settings[Brand and API configuration]
            Schedule[Optional scheduled runner]
        end
        Files[(YAML / JSON / photos / assets)]
        Keys[(Local .env credentials)]
        FFmpeg[FFmpeg and ffprobe]
        Output[(MP4s and posting captions)]
        Local[Optional local model server]
    end
    subgraph Cloud[External services - only when selected]
        Text[Gemini / Inception text APIs]
        Vision[Gemini image analysis]
        Speech[Edge / gTTS / Gemini / ElevenLabs speech]
        Stock[Pexels / Pixabay]
    end
    User --> Browser --> Web
    User --> CLI --> Work
    Web --> Work
    Web --> Media
    Web --> Settings
    Settings --> Files
    Settings --> Keys
    Files --> Work
    Keys -. credential resolution .-> Work
    Media <--> Files
    Media --> Vision
    Media --> Stock
    Work --> Text
    Work --> Local
    Work --> Speech
    Work --> FFmpeg --> Output
    Files --> FFmpeg
    CLI --> Schedule --> Work
    Output --> Browser
