# Copy this file to ".env" (same folder as brand.yaml) and fill in what you
# use. Every key here is optional -- the defaults (template scripts + edge-tts
# voices) need no account at all.
#
# Keys are ONLY read from here, from a real environment variable, or from a
# --*-key flag. They are never read from brand.yaml, so a client's brand file
# can be shared or committed without leaking anything. ".env" itself is
# gitignored; this example file is not.
#
# Names are matched case-insensitively, and quotes around a value are optional.

# --- Gemini: --script ai and --tts gemini ---------------------------------
# https://aistudio.google.com/apikey
gemini_key=

# Optional second Gemini key. Used automatically, but only when the primary
# key hits a quota / rate limit (HTTP 429) -- free-tier TTS runs out quickly.
key_backup=

# --- Grok (xAI): --script grok --------------------------------------------
# https://console.x.ai
GROK_API_KEY=

# --- Local model: --script local ------------------------------------------
# Ollama / LM Studio need no key. Set this only if your server demands one.
# The URL and model name are not secrets and live in brand.yaml instead.
LOCAL_LLM_API_KEY=

# --- Stock photos: "reelfactory photos" and "Find free photos" in the web UI
# Both are free and take about a minute to get. Either one on its own works;
# with both set, results from the two are interleaved.
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
